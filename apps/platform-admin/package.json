{
  "name": "@sanvi/platform-admin",
  "version": "0.1.0",
  "description": "Sanvi platform operator console — Svelte SPA behind auth + MFA. Different privilege tier from @sanvi/admin; shares every package, not a build target.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:i18n": "sanvi-check-i18n src",
    "check:tokens": "sanvi-check-tokens src",
    "check:budget": "sanvi-check-budget --app platform-admin"
  },
  "dependencies": {
    "@sanvi/api-client": "workspace:*",
    "@sanvi/auth": "workspace:*",
    "@sanvi/csp": "workspace:*",
    "@sanvi/design-tokens": "workspace:*",
    "@sanvi/i18n": "workspace:*",
    "@sanvi/query": "workspace:*",
    "@sanvi/spa-router": "workspace:*",
    "@sanvi/telemetry": "workspace:*",
    "@sanvi/ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sanvi/lint-gates": "workspace:*",
    "@sanvi/test-config": "workspace:*",
    "@sanvi/ts-config": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
