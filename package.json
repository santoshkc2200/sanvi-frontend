{
  "name": "sanvi-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Sanvi frontend monorepo — SvelteKit storefront/marketing, Svelte admin SPAs, shared packages.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && eslint .",
    "lint:fix": "turbo run lint -- --write && eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:quiet": "turbo run test --output-logs=errors-only -- --reporter=dot",
    "test:e2e": "turbo run test:e2e",
    "check:i18n": "turbo run check:i18n",
    "check:tokens": "turbo run check:tokens",
    "check:boundaries": "node packages/lint-gates/src/check-boundaries.mjs .",
    "check:images": "node packages/lint-gates/src/check-image-dimensions.mjs .",
    "check:budget": "node scripts/check-budget.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "bench:run": "node scripts/bench-run.mjs",
    "bench:compare": "node scripts/bench-compare.mjs",
    "check:connect-bundle": "node scripts/assert-connect-js-bundle.mjs",
    "check:secrets": "node scripts/check-no-secret-keys-in-bundle.mjs",
    "check:sourcemaps-not-served": "node scripts/check-sourcemaps-not-served.mjs",
    "check:all": "pnpm lint && turbo run typecheck test build check:i18n check:tokens check:budget i18n:check && pnpm check:boundaries && pnpm check:images && pnpm check:connect-bundle && pnpm check:sourcemaps-not-served && pnpm check:csp && pnpm check:storage-surface && pnpm check:runtime-code-sources && pnpm check:i18n-shards && pnpm check:secrets && node packages/lint-gates/src/check-budget.mjs --all",
    "check:quiet": "pnpm lint && turbo run typecheck test build check:i18n check:tokens check:budget i18n:check --output-logs=errors-only && pnpm check:boundaries && pnpm check:images && pnpm check:connect-bundle && pnpm check:sourcemaps-not-served && pnpm check:csp && pnpm check:storage-surface && pnpm check:runtime-code-sources && pnpm check:i18n-shards && pnpm check:secrets && node packages/lint-gates/src/check-budget.mjs --all",
    "generate:api": "node scripts/generate-openapi.mjs",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky",
    "check:csp": "node packages/lint-gates/src/check-csp.mjs .",
    "check:storage-surface": "node packages/lint-gates/src/check-storage-surface.mjs .",
    "check:runtime-code-sources": "node packages/lint-gates/src/check-runtime-code-sources.mjs .",
    "check:i18n-shards": "node scripts/check-i18n-shards.mjs",
    "i18n:check": "pnpm --filter @sanvi/i18n run i18n:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "catalog:",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "catalog:",
    "@sanvi/lint-gates": "workspace:*",
    "eslint": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "husky": "^9.1.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^15.2.0",
    "openapi-typescript": "catalog:",
    "rimraf": "catalog:",
    "svelte": "catalog:",
    "svelte-eslint-parser": "catalog:",
    "turbo": "^2.3.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,svelte,json}": [
      "biome format --write",
      "biome lint --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess"
    ],
    "overrides": {
      "@vitest/expect": "catalog:",
      "@vitest/spy": "catalog:",
      "@vitest/utils": "catalog:",
      "@vitest/snapshot": "catalog:",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "fast-uri@>=3.0.0 <3.1.6": ">=3.1.6",
      "devalue@<5.9.2": ">=5.9.2",
      "tmp@<0.2.6": ">=0.2.6"
    },
    "patchedDependencies": {
      "chrome-launcher@1.2.1": "patches/chrome-launcher@1.2.1.patch"
    }
  }
}
