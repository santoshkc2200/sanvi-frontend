{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["biome.json", ".env"],
  "globalEnv": [
    "NODE_ENV",
    "PUBLIC_API_ORIGIN",
    "PUBLIC_MEDIA_ORIGIN",
    "PUBLIC_KRATOS_ORIGIN",
    "PUBLIC_SITE_ORIGIN",
    "VITE_API_ORIGIN",
    "VITE_MEDIA_ORIGIN",
    "VITE_KRATOS_ORIGIN",
    "VITE_STRIPE_PUBLISHABLE_KEY",
    "SANVI_GIT_COMMIT",
    "SANVI_BUILT_AT",
    "SANVI_ENVIRONMENT"
  ],
  "globalPassThroughEnv": ["CHROME_PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".svelte-kit/**", "build/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "check:i18n": {
      "outputs": []
    },
    "check:tokens": {
      "outputs": []
    },
    "check:budget": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "i18n:check": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
