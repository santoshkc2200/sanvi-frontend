{
  "name": "@sanvi/telemetry",
  "version": "0.1.0",
  "description": "Lab-safe RUM collector for Sanvi — Core Web Vitals plus navigation and resource timing, sampled, scrubbed of PII and query strings, and gated through the phase-05 directive resolver like any other purpose. Ships wired but off: there is no collector endpoint and no traffic (docs/release/needs-humans.md); enabling it later is configuration, not a project.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./release": {
      "types": "./src/node/release-stamp.ts",
      "default": "./src/node/release-stamp.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sanvi/api-client": "workspace:*",
    "@sanvi/consent": "workspace:*",
    "web-vitals": "catalog:"
  },
  "devDependencies": {
    "@sanvi/test-config": "workspace:*",
    "@sanvi/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
