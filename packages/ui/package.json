{
  "name": "@sanvi/ui",
  "version": "0.1.0",
  "description": "Sanvi component library — Svelte 5 runes, token-driven, a11y-first. Depends only on @sanvi/design-tokens; never imports @sanvi/api-client and never fetches.",
  "private": true,
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/reset.css",
    "./test-fixtures": "./__tests__/fixtures/advertising/index.ts"
  },
  "sideEffects": [
    "./src/styles/*.css"
  ],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "check:i18n": "sanvi-check-i18n src",
    "check:tokens": "sanvi-check-tokens src"
  },
  "peerDependencies": {
    "svelte": "catalog:"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@sanvi/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@sanvi/lint-gates": "workspace:*",
    "@sanvi/test-config": "workspace:*",
    "@sanvi/ts-config": "workspace:*",
    "@storybook/addon-a11y": "^8.4.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/addon-svelte-csf": "^5.0.0",
    "@storybook/svelte": "^8.4.0",
    "@storybook/svelte-vite": "^8.4.0",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "storybook": "^8.4.0",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
