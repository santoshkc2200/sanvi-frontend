{
  "$schema": "https://tokens.studio/schema/draft.json",
  "primitive": {
    "$description": "Brand color primitives and native spacing scale — never use directly in components",
    "color": {
      "blue": {
        "50": { "$value": "#eff6ff", "$type": "color" },
        "300": { "$value": "#93c5fd", "$type": "color" },
        "400": { "$value": "#60a5fa", "$type": "color" },
        "500": { "$value": "#3b82f6", "$type": "color" },
        "600": { "$value": "#2563eb", "$type": "color" },
        "700": { "$value": "#1d4ed8", "$type": "color" },
        "800": { "$value": "#1e40af", "$type": "color" },
        "950": { "$value": "#0c2340", "$type": "color" }
      },
      "purple": {
        "50": { "$value": "#f5f3ff", "$type": "color" },
        "400": { "$value": "#a78bfa", "$type": "color" },
        "500": { "$value": "#8b5cf6", "$type": "color" },
        "600": { "$value": "#7c3aed", "$type": "color" },
        "700": { "$value": "#6d28d9", "$type": "color" },
        "900": { "$value": "#4c1d95", "$type": "color" }
      },
      "gray": {
        "0": { "$value": "#ffffff", "$type": "color" },
        "50": { "$value": "#f8fafc", "$type": "color" },
        "100": { "$value": "#f1f5f9", "$type": "color" },
        "200": { "$value": "#e2e8f0", "$type": "color" },
        "300": { "$value": "#cbd5e1", "$type": "color" },
        "400": { "$value": "#94a3b8", "$type": "color" },
        "500": { "$value": "#64748b", "$type": "color" },
        "600": { "$value": "#475569", "$type": "color" },
        "700": { "$value": "#334155", "$type": "color" },
        "800": { "$value": "#1e293b", "$type": "color" },
        "900": { "$value": "#0f172a", "$type": "color" },
        "950": { "$value": "#020617", "$type": "color" }
      },
      "green": {
        "50": { "$value": "#f0fdf4", "$type": "color" },
        "100": { "$value": "#dcfce7", "$type": "color" },
        "500": { "$value": "#22c55e", "$type": "color" },
        "600": { "$value": "#16a34a", "$type": "color" },
        "800": { "$value": "#166534", "$type": "color" }
      },
      "amber": {
        "50": { "$value": "#fffbeb", "$type": "color" },
        "100": { "$value": "#fef3c7", "$type": "color" },
        "500": { "$value": "#f59e0b", "$type": "color" },
        "600": { "$value": "#d97706", "$type": "color" },
        "800": { "$value": "#92400e", "$type": "color" }
      },
      "red": {
        "50": { "$value": "#fef2f2", "$type": "color" },
        "100": { "$value": "#fee2e2", "$type": "color" },
        "500": { "$value": "#ef4444", "$type": "color" },
        "600": { "$value": "#dc2626", "$type": "color" },
        "800": { "$value": "#991b1b", "$type": "color" }
      },
      "teal": {
        "50": { "$value": "#f0fdfa", "$type": "color" },
        "100": { "$value": "#ccfbf1", "$type": "color" },
        "500": { "$value": "#14b8a6", "$type": "color" },
        "600": { "$value": "#0d9488", "$type": "color" },
        "800": { "$value": "#115e59", "$type": "color" }
      }
    },
    "spacing": {
      "$description": "Shared spacing scale — web (ui package layout primitives) and native both consume this.",
      "0": { "$value": "0rem", "$type": "spacing" },
      "1": { "$value": "0.25rem", "$type": "spacing" },
      "2": {
        "$value": "0.5rem",
        "$type": "spacing",
        "$extensions": { "sanvi": { "platforms": ["ios", "android"] } }
      },
      "3": { "$value": "0.75rem", "$type": "spacing" },
      "4": {
        "$value": "1rem",
        "$type": "spacing",
        "$extensions": { "sanvi": { "platforms": ["ios", "android"] } }
      },
      "5": { "$value": "1.25rem", "$type": "spacing" },
      "6": { "$value": "1.5rem", "$type": "spacing" },
      "8": {
        "$value": "2rem",
        "$type": "spacing",
        "$extensions": { "sanvi": { "platforms": ["ios", "android"] } }
      },
      "10": { "$value": "2.5rem", "$type": "spacing" },
      "12": {
        "$value": "3rem",
        "$type": "spacing",
        "$extensions": { "sanvi": { "platforms": ["ios", "android"] } }
      },
      "16": {
        "$value": "4rem",
        "$type": "spacing",
        "$extensions": { "sanvi": { "platforms": ["ios", "android"] } }
      },
      "20": { "$value": "5rem", "$type": "spacing" },
      "24": { "$value": "6rem", "$type": "spacing" },
      "32": { "$value": "8rem", "$type": "spacing" },
      "48": { "$value": "12rem", "$type": "spacing" }
    },
    "radius": {
      "$description": "Border-radius scale for the ui package — never a raw px/rem radius in a component.",
      "none": { "$value": "0rem", "$type": "borderRadius" },
      "sm": { "$value": "0.25rem", "$type": "borderRadius" },
      "md": { "$value": "0.375rem", "$type": "borderRadius" },
      "lg": { "$value": "0.5rem", "$type": "borderRadius" },
      "xl": { "$value": "0.75rem", "$type": "borderRadius" },
      "full": { "$value": "9999px", "$type": "borderRadius" }
    },
    "border-width": {
      "thin": { "$value": "1px", "$type": "dimension" },
      "thick": { "$value": "2px", "$type": "dimension" }
    },
    "font-family": {
      "$description": "Locale-aware font stacks land in phase 06; this is the Latin-tuned default every component starts from.",
      "sans": {
        "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "ui-monospace, 'SF Mono', 'Cascadia Code', 'Roboto Mono', Menlo, monospace",
        "$type": "fontFamily"
      }
    },
    "font-size": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "md": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "$type": "dimension" }
    },
    "font-weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" }
    },
    "line-height": {
      "$description": "Unitless multipliers; locale-aware overrides (CJK needs looser leading) land in phase 06.",
      "tight": { "$value": "1.25", "$type": "number" },
      "normal": { "$value": "1.5", "$type": "number" },
      "relaxed": { "$value": "1.75", "$type": "number" }
    },
    "z-index": {
      "$description": "Stacking-context scale so Dialog/Drawer/Toast never fight over an ad-hoc z-index.",
      "dropdown": { "$value": "1000", "$type": "number" },
      "overlay": { "$value": "1100", "$type": "number" },
      "modal": { "$value": "1200", "$type": "number" },
      "toast": { "$value": "1300", "$type": "number" }
    }
  }
}
