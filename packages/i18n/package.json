{
  "name": "@sanvi/i18n",
  "version": "0.1.0",
  "description": "Message catalogs, locale negotiation, and Intl formatters — compiled, type-checked catalogs (a missing key in any locale is a build error), no runtime catalog fetch, ICU subset for plurals.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./routing": {
      "types": "./src/routing.ts",
      "default": "./src/routing.ts"
    },
    "./surfaces/storefront": {
      "types": "./src/surfaces/storefront.ts",
      "default": "./src/surfaces/storefront.ts"
    },
    "./surfaces/marketing": {
      "types": "./src/surfaces/marketing.ts",
      "default": "./src/surfaces/marketing.ts"
    },
    "./surfaces/admin": {
      "types": "./src/surfaces/admin.ts",
      "default": "./src/surfaces/admin.ts"
    },
    "./surfaces/platform-admin": {
      "types": "./src/surfaces/platform-admin.ts",
      "default": "./src/surfaces/platform-admin.ts"
    },
    "./surfaces/all": {
      "types": "./src/surfaces/all.ts",
      "default": "./src/surfaces/all.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "i18n:check": "node tools/check.mjs",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@sanvi/test-config": "workspace:*",
    "@sanvi/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
