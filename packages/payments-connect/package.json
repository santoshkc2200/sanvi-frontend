{
  "name": "@sanvi/payments-connect",
  "version": "0.1.0",
  "description": "Stripe Connect.js loader and embedded onboarding wrapper for Sanvi — admin only, not storefront",
  "private": true,
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./AccountOnboarding.svelte": "./src/AccountOnboarding.svelte"
  },
  "sideEffects": false,
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sanvi/design-tokens": "workspace:*",
    "@stripe/connect-js": "catalog:"
  },
  "peerDependencies": {
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@sanvi/test-config": "workspace:*",
    "@sanvi/ts-config": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/jest-dom": "6.6.0",
    "@testing-library/svelte": "5.2.0",
    "jsdom": "25.0.0",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
