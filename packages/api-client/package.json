{
  "name": "@sanvi/api-client",
  "version": "0.1.0",
  "description": "Typed fetch runtime shared by every Sanvi app \u2014 auth/tenant headers, retries, timeouts, problem+json error mapping. The generated OpenAPI client (phase 01) wraps this.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./problem": {
      "types": "./src/problem.ts",
      "default": "./src/problem.ts"
    },
    "./offline": {
      "types": "./src/offline.ts",
      "default": "./src/offline.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sanvi/test-config": "workspace:*",
    "@sanvi/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
