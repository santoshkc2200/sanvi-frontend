{
  "name": "@sanvi/theme-blocks",
  "version": "0.1.0",
  "description": "Catalog of customizable theme blocks for Sanvi storefronts",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome lint --write . && biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "sanvi-check-i18n src",
    "check:tokens": "sanvi-check-tokens src"
  },
  "peerDependencies": {
    "svelte": "catalog:"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@sanvi/api-client": "workspace:*",
    "@sanvi/design-tokens": "workspace:*",
    "@sanvi/i18n": "workspace:*",
    "@sanvi/theme-runtime": "workspace:*",
    "@sanvi/ui": "workspace:*"
  },
  "devDependencies": {
    "@sanvi/lint-gates": "workspace:*",
    "@sanvi/test-config": "workspace:*",
    "@sanvi/ts-config": "workspace:*",
    "@storybook/addon-svelte-csf": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
