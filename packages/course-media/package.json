{
  "name": "@sanvi/course-media",
  "version": "0.1.0",
  "description": "Svelte and SvelteKit-compatible media upload, HLS playback, captions, and image utilities for Sanvi",
  "private": true,
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./VideoPlayer.svelte": "./src/VideoPlayer.svelte",
    "./ChapterList.svelte": "./src/ChapterList.svelte",
    "./ChapterEditor.svelte": "./src/ChapterEditor.svelte",
    "./CaptionEditor.svelte": "./src/CaptionEditor.svelte",
    "./LectureImage.svelte": "./src/LectureImage.svelte"
  },
  "sideEffects": false,
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "svelte": "catalog:"
  },
  "dependencies": {
    "hls.js": "^1.6.16"
  },
  "devDependencies": {
    "@sanvi/test-config": "workspace:*",
    "@sanvi/ts-config": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
