# Copy to .env for local `turbo run dev`. Each app also has its own
# .env.example (apps/admin, apps/platform-admin) for its Vite-prefixed vars.

# SvelteKit apps (marketing, storefront) read these via $env/dynamic/private.
PUBLIC_API_ORIGIN=http://localhost:8080
PUBLIC_MEDIA_ORIGIN=
# Ory Kratos's public API (sanvi-backend/configs/ory/kratos.yml's serve.public.base_url).
# Only storefront actually calls it; marketing doesn't render auth screens.
PUBLIC_KRATOS_ORIGIN=http://localhost:4433

# Local-only credentials for interactive Playwright CLI testing. These are not
# seeded by the backend; register this account in Kratos, then grant roles as
# documented in .playwright/MEMORY.md.
PLAYWRIGHT_TEST_EMAIL=owner@example.com
PLAYWRIGHT_TEST_PASSWORD=SanviLocalE2E!2026
PLAYWRIGHT_TEST_TENANT=acme
PLAYWRIGHT_PLATFORM_TEST_EMAIL=operator@example.com
PLAYWRIGHT_PLATFORM_TEST_PASSWORD=SanviLocalE2E!2026
