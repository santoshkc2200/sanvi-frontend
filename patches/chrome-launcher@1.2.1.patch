@@ -364,7 +364,13 @@ class Launcher {
         // backwards support for node v12 + v14.14+
         // https://nodejs.org/api/deprecations.html#DEP0147
         const rmSync = this.fs.rmSync || this.fs.rmdirSync;
+        // Windows: a chrome crashpad child can hold the profile dir past the 10
+        // rmSync retries; a leftover tmp dir beats a crashed audit run.
+        try {
         rmSync(this.userDataDir, { recursive: true, force: true, maxRetries: 10 });
+        } catch (err) {
+            log.warn('ChromeLauncher', `tmp dir cleanup failed: ${err.message}`);
+        }
     }
 }
